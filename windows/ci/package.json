{
  "schemaVersion": 1,
  "distribution": "dll-only",
  "files": [
    {
      "source": "upstream",
      "path": "wal2json.dll",
      "destination": "lib/wal2json.dll",
      "targets": [
        "install",
        "zip"
      ]
    },
    {
      "source": "license",
      "path": "LICENSE",
      "destination": "LICENSE",
      "targets": [
        "zip"
      ]
    },
    {
      "source": "upstream",
      "path": "README.md",
      "destination": "UPSTREAM-README.md",
      "targets": [
        "zip"
      ]
    },
    {
      "source": "packaging",
      "path": "README.md",
      "destination": "PGEXTWIN-README.md",
      "targets": [
        "zip"
      ]
    }
  ],
  "packageInfo": [
    "wal2json Windows x64 output plugin (unofficial pgextwin pilot)",
    "Upstream repository: {upstreamRepository}",
    "Upstream ref: {upstreamRef}",
    "Upstream commit: {upstreamCommit}",
    "Version: {version}",
    "PostgreSQL major: {pgMajor}",
    "PostgreSQL tested: {pgTested}",
    "Architecture: Windows x64",
    "License: BSD-3-Clause; see LICENSE",
    "",
    "Install lib/wal2json.dll in PostgreSQL/lib, set wal_level=logical and configure logical replication slots.",
    "PostgreSQL security-updated versions require output_plugin_libraries to include wal2json.",
    "This is an output plugin, not a SQL extension: DO NOT run CREATE EXTENSION wal2json.",
    "Official documentation: https://www.postgresql.org/docs/18/runtime-config-replication.html"
  ],
  "packageInfoFinalNewline": false
}
